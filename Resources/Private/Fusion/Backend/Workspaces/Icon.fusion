##
# The line icons of the moderation app (Devclaim.NeosModeration), so both look alike: decorative, the buttons have their
# text or an aria-label
#
prototype(Devclaim.NeosModernBackend:Icon) < prototype(Neos.Fusion:Component) {
    name = ''
    size = 16

    @private {
        paths = Neos.Fusion:DataStructure {
            trash = 'M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6M14 11v6'
            select = 'M3.5 6l1.5 1.5 3-3M3.5 12l1.5 1.5 3-3M3.5 18l1.5 1.5 3-3M11 6h9M11 12h9M11 18h9'
            selectAll = 'M4 4h16v16H4zM8 12l3 3 5-6'
            selectNone = 'M4 4h16v16H4zM8 12h8'
            restore = 'M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M12 17v-6M9.5 13.5L12 11l2.5 2.5'
            search = 'M11 18a7 7 0 100-14 7 7 0 000 14zM20 20l-3.5-3.5'
            close = 'M6 6l12 12M18 6L6 18'
            inbox = 'M3 13h5l2 3h4l2-3h5M5 5h14l2 8v6H3v-6z'
        }
    }

    renderer = afx`
        <svg
            width={props.size}
            height={props.size}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
        >
            <path d={private.paths[props.name]}/>
        </svg>
    `
}
